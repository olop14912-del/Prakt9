<Window x:Class="Prakt9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа №9"
        Height="430"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock Text="Поиск числа в интервале" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Введите числа через пробел:"/>
        <TextBox x:Name="txtNumbers" Text="1 5 10 15 20" Height="30" Margin="0,5,0,15"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="a:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtA" Text="7" Width="80" Height="30" Margin="5"/>
            <TextBlock Text="b:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtB" Text="16" Width="80" Height="30" Margin="5"/>
        </StackPanel>

        <Button Content="Проверить" Width="180" Height="35" Margin="5,15" HorizontalAlignment="Center" Click="Check_Click"/>

        <TextBlock x:Name="txtResult" Text="Результат" FontSize="17" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,20"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="О программе" Width="140" Height="35" Margin="5" Click="About_Click"/>
            <Button Content="Выход" Width="140" Height="35" Margin="5" Click="Exit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>